{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/graphify-query.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/graphify-autoupdate.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-secrets.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pint-format.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(./vendor/bin/sail up -d)",
      "Bash(./vendor/bin/sail ps:*)",
      "Bash(./vendor/bin/sail artisan test:*)",
      "Bash(./vendor/bin/sail artisan route:list:*)",
      "Bash(./vendor/bin/sail artisan migrate:status)",
      "Bash(./vendor/bin/sail artisan about:*)",
      "Bash(./vendor/bin/sail artisan --version)",
      "Bash(./vendor/bin/sail artisan config:show:*)",
      "Bash(./vendor/bin/sail artisan horizon:status)",
      "Bash(./vendor/bin/sail php vendor/bin/pint:*)",
      "Bash(./vendor/bin/sail php vendor/bin/phpstan:*)",
      "Bash(./vendor/bin/sail composer install)",
      "Bash(./vendor/bin/sail composer show:*)",
      "Bash(./vendor/bin/sail composer dump-autoload:*)",
      "Bash(docker compose ps:*)",
      "Bash(npm run types:check)",
      "Bash(npm run lint:check)",
      "Bash(npm run format:check)",
      "Bash(npm run build)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(.env)",
      "Read(./**/*.key)",
      "Read(./**/*.pem)"
    ]
  }
}
